{
  "name": "threat-intel-workbench-backend",
  "version": "4.0.0",
  "description": "Professional SOC analyst tool for IOC investigation",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "lint": "eslint src/ frontend/js/",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "db:reset": "npm run migrate:undo && npm run migrate",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "node-cache": "^5.1.2",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "whois": "^2.16.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.51.0",
    "fs-extra": "^11.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "threat-intelligence",
    "ioc",
    "security",
    "soc"
  ],
  "author": "Threat Intel Team",
  "license": "MIT"
}
