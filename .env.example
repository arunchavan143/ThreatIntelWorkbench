# ============================================================
# Threat Intel Workbench Pro - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================
# Install PostgreSQL locally or use Docker
# Create database: createdb threat_intel

DB_HOST=localhost
DB_PORT=5432
DB_NAME=threat_intel
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres

# ============================================================
# THREAT INTELLIGENCE API KEYS
# ============================================================
# Get free keys from:
#   VirusTotal:    https://www.virustotal.com/gui/join-us
#   AbuseIPDB:     https://www.abuseipdb.com/register
#   Shodan:        https://account.shodan.io/register
#   AlienVault OTX: https://otx.alienvault.com/register
#   URLScan:       https://urlscan.io/user/signup
#   Groq:          https://console.groq.com/keys

VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here
OTX_API_KEY=your_otx_api_key_here
URLSCAN_API_KEY=your_urlscan_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# CACHE CONFIGURATION
# ============================================================
CACHE_TTL_SECONDS=1800
ENABLE_CACHE=true

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true

# ============================================================
# DEFAULT SETTINGS
# ============================================================
DEFAULT_ANALYST_NAME=SOC_Analyst
MAX_BATCH_SIZE=10